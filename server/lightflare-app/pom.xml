<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.lightflare</groupId>
		<artifactId>lightflare-parent</artifactId>
		<version>1.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>lightflare-app</artifactId>

	<properties>
		<lucene-analysis-common.version>10.4.0</lucene-analysis-common.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jdbc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
		</dependency>


		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-analysis-common</artifactId>
			<version>${lucene-analysis-common.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-tool-core</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- project sub modules -->
		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-slack</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-openai</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-ollama</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-openrouter</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-playwright</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-openmeteo</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-brave-search</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-postgres</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-httpclient</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-document</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.lightflare</groupId>
			<artifactId>lightflare-mcp-client</artifactId>
			<version>${project.version}</version>
		</dependency>


		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
